# Artemis Configuration
# Copy to .env and fill in values

# Flask
SECRET_KEY=change-me-to-a-random-string
DEBUG=false
FLASK_CONFIG=default

# Server
HOST=0.0.0.0
PORT=5000

# Database (default: SQLite in project root)
# For PostgreSQL: postgresql://user:pass@localhost:5432/artemis
DATABASE_URL=sqlite:///vuln_scan.db
DB_PATH=vuln_scan.db

# Redis / Celery (optional — enables async scanning)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# NVD API Key (optional — increases rate limit from 5/30s to 50/30s)
# NVD_API_KEY=your-nvd-api-key-here

# Scan profiles
# SCAN_PROFILES_PATH=scan_profiles.json
