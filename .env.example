# Artemis Configuration
# Copy to .env and fill in values.

# ---------------------------------------------------------------------------
# Docker Compose deployment (docker compose up -d)
# ---------------------------------------------------------------------------
# Required. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
# Required. Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me
# Host port the web UI is published on (container always listens on 5005).
WEB_PORT=5005
# Optional. Pin a nuclei release (e.g. 3.4.7); empty = latest at build time.
NUCLEI_VERSION=
# Optional. NVD API key — raises the rate limit from 5/30s to 50/30s.
NVD_API_KEY=
# Only set these when using docker-compose.host.yml (host networking):
#   DB_HOST=127.0.0.1
#   REDIS_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Local (non-Docker) development — python run.py
# ---------------------------------------------------------------------------
DEBUG=false
FLASK_CONFIG=development

# Server
HOST=0.0.0.0
PORT=5005

# Database — system of record. SQLite is for local development only.
# PostgreSQL: postgresql+psycopg://artemis:password@localhost:5432/artemis
DATABASE_URL=sqlite:///vuln_scan.db
# Local SQLite read-cache for NVD/CPE/ExploitDB feeds (public, re-syncable data).
# Defaults to DB_PATH. Not the system of record.
NVD_CACHE_PATH=vuln_scan.db
# Pre-Postgres SQLite DB the one-time migrator copies application rows from.
# Defaults to DB_PATH; set empty to skip the migration.
LEGACY_SQLITE_PATH=vuln_scan.db
DB_PATH=vuln_scan.db
AUTO_CREATE_SCHEMA=true
INITIALIZE_LEGACY_SCHEMA=true
START_BACKGROUND_SERVICES=true

# Redis / Celery (required with FLASK_CONFIG=production)
# Local development runs tasks eagerly when these are omitted.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_TASK_TIME_LIMIT=7200

# Scan profiles
# SCAN_PROFILES_PATH=scan_profiles.json
