# Artemis Configuration
# Copy to .env and fill in values

# Flask
SECRET_KEY=change-me-to-a-random-string
DEBUG=false
FLASK_CONFIG=development

# Server
HOST=0.0.0.0
PORT=5005

# Database (SQLite is for local development only)
# PostgreSQL: postgresql+psycopg://artemis:password@localhost:5432/artemis
DATABASE_URL=sqlite:///vuln_scan.db
DB_PATH=vuln_scan.db
AUTO_CREATE_SCHEMA=true
INITIALIZE_LEGACY_SCHEMA=true
START_BACKGROUND_SERVICES=true

# Redis / Celery (required with FLASK_CONFIG=production)
# Local development runs tasks eagerly when these are omitted.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_TASK_TIME_LIMIT=7200

# NVD API Key (optional — increases rate limit from 5/30s to 50/30s)
# NVD_API_KEY=your-nvd-api-key-here

# Scan profiles
# SCAN_PROFILES_PATH=scan_profiles.json
