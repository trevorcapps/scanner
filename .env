# Artemis Configuration
# Copy to .env and fill in values.

# ---------------------------------------------------------------------------
# Docker Compose deployment (docker compose up -d)
# ---------------------------------------------------------------------------
# Required. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9db3229946ebee4a1068f984cc046a224afca5075e9b1fff5a224aa6231ef4e4
# Required. Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=DtC4b0stshIbw3NfQepRFZt3kpYXg1Xy
# Host port the web UI is published on (container always listens on 5005).
WEB_PORT=5005
# Optional. Pin a nuclei release (e.g. 3.4.7); empty = latest at build time.
NUCLEI_VERSION=
# Optional. NVD API key — raises the rate limit from 5/30s to 50/30s.
NVD_API_KEY=

# ---------------------------------------------------------------------------
# Local (non-Docker) development — python run.py
# ---------------------------------------------------------------------------
DEBUG=false
FLASK_CONFIG=development

# Server
HOST=0.0.0.0
PORT=5005

# Database (SQLite is for local development only)
# PostgreSQL: postgresql+psycopg://artemis:password@localhost:5432/artemis
DATABASE_URL=sqlite:///vuln_scan.db
DB_PATH=vuln_scan.db
AUTO_CREATE_SCHEMA=true
INITIALIZE_LEGACY_SCHEMA=true
START_BACKGROUND_SERVICES=true

# Redis / Celery (required with FLASK_CONFIG=production)
# Local development runs tasks eagerly when these are omitted.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_TASK_TIME_LIMIT=7200

# Scan profiles
# SCAN_PROFILES_PATH=scan_profiles.json
